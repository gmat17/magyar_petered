# Területi autokorreláció
# Autokorreláció: változó önmagával korrelál
# jelenlegi érték saját múltjával
# sima korreláció:
# y_i = i-edik ember jövedelme
# x_i = i-edik ember iskolai végzettsége
# r(y_i, x_i) --> együttmozgása a két változónak [-1; +1] intervallumban
# y_t = EUR-HUF árfolyam t-edik időszakban
# autokorreláció
# r(y_t, y_t-k) --> k-ad rendű autokorreláció
# y_t-k = y idősor k-adik késleltetése ('lagja')
# ACF: autocorrelation function
# r(y_t, y_t-1), r(y_t, y_t-2), ..., r(y_t, y_t-k) --> sorbarendezés
# ACF(2) = r(y_t, y_t-2)
arfolyam <- readxl::read_excel('EURHUF.xlsx')
arfolyam$Date <- as.Date(arfolyam$Date)
library(ggplot2)
ggplot(arfolyam, aes(x=Date, y=EUR)) +
geom_line(linewidth=1)
arfolyam$EUR_lag1 <- c(NA,arfolyam$EUR[1:(nrow(arfolyam)-1)])
arfolyam$EUR_lag2 <- c(NA,NA,arfolyam$EUR[1:(nrow(arfolyam)-2)])
autocor <- cor(arfolyam[-c(1:2),-1])
autocor # acf --> első sor vagy első oszlop
acf(arfolyam$EUR)
# autókorreláció: "jelen hogyan függ a múlttól"
# Területi autokorreláció
# y_i = medián jövedelem az i-edik járásban
# --> i-edik régió mediánjöv hogyan függ a szomszédoktól, "y_i-k"-tól
# gyakorlati problémák
# melyik 1. rendű szomszéd? --> és 2-nak? --> hol a határ?
# mennyien vannak?
# kétféle megoldás:
# 1) Morgan's I
# 2) Geary's C
teradat <- readxl::read_excel('spatialdata.xlsx')
View(teradat)
View(teradat)
teradat[,c('hossz', 'szel')]
# jövedelemben mérjünk területi autokorreálációt
# távolságmátrix a járásokra: mértani középpontok alapján
tavolsag <- dist(teradat[,c('hossz', 'szel')])
tavolsag
# jövedelemben mérjünk területi autokorreálációt
# távolságmátrix a járásokra: mértani középpontok alapján
tavolsag <- as.matrix(dist(teradat[,c('hossz', 'szel')]))
tavolsag
View(tavolsag)
View(tavolsag)
rownames(tavolsag) <- teradat$jaras
colnames(tavolsag) <- teradat$jaras
View(tavolsag)
View(tavolsag)
inverz_tav <- 1/tavolsag^2
View(inverz_tav)
View(inverz_tav)
diag(inverz_tav) <- 0
weight_matrix <- inverz_tav
