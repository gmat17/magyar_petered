model_1 <- lm(data = mt, mpg ~ hp + wt + qsec)
# model 1: all variables without transformation --> simpliest way
model_2 <- lm(data = mt, mpg ~ PC1_all + I(PC1_all^2))
# model 2: just the above created PC1_all and its quadratic form
model_3 <- lm(data = mt, log(mpg) ~ PC1 + qsec)
# model 3: above create PC1 and qsec
model_4 <- lm(data = mt, log(mpg) ~  log(hp) + log(wt) + log(qsec))
# model 4: all variables with log transformation
model_5 <- lm(data = mt, log(mpg) ~ PC1_log + log(qsec))
# model 5: model 4 with PC1 instead of hp and wt
adj.r.sqrs <- c(
summary(model_1)$adj.r.squared,
summary(model_2)$adj.r.squared,
summary(model_3)$adj.r.squared,
summary(model_4)$adj.r.squared, # very close to first!
summary(model_5)$adj.r.squared # highest adj.r.squared!
)
adj.r.sqrs
plot(adj.r.sqrs)
# same with BIC: greatest penalty on the number of the components
BICs <- c(BIC(model_1),BIC(model_2),BIC(model_3),BIC(model_4),BIC(model_5))
BICs
plot(BICs)
adj.r.sqrs
plot(adj.r.sqrs)
plot(BICs)
plot(adj.r.sqrs)
